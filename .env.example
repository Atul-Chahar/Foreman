# ─────────────────────────────────────────────────────────────────────────────
# Foreman configuration
# Copy to .env and fill in. NEVER commit .env — secrets come from the
# environment only. See README § Control & safety.
# ─────────────────────────────────────────────────────────────────────────────

# ── The target repo the swarm works on (Repo B, e.g. foreman-demo-target) ──
# Absolute path to a local clone for offline mode, or owner/name for GitHub.
FOREMAN_TARGET_LOCAL=./demo-target
FOREMAN_TARGET_GITHUB=

# ── GitHub MCP server (real tool calls: read issues, branches, PRs, merge) ──
# Any stdio MCP server that exposes GitHub tools. Example:
#   FOREMAN_MCP_COMMAND=docker
#   FOREMAN_MCP_ARGS=run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
# When unset, Foreman uses the LocalGit MCP adapter (same tool surface,
# real git operations, offline-friendly).
FOREMAN_MCP_COMMAND=
FOREMAN_MCP_ARGS=

# GitHub token used by the MCP server above (passed through its own env).
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── TrueForge (orchestration, sandboxing, subagents, approvals) ──
# When set, implementer subagents are dispatched to TrueForge sessions.
# When unset, Foreman runs the local execution backend (see harness/subagents/).
FOREMAN_TRUEFORGE_URL=
FOREMAN_TRUEFORGE_TOKEN=

# ── Policy defaults (see harness/policy/tiers.mjs) ──
# T0 (read-only) is always auto-approved. T2 (irreversible) is ALWAYS gated —
# there is no setting that can change this, by design.
# T1 (reversible writes) defaults to gated. Enable auto for faster demos:
# FOREMAN_T1_AUTO=true
FOREMAN_T1_AUTO=false

# ── Swarm size and limits (scope discipline: 8, not 100) ──
FOREMAN_MAX_CONCURRENCY=8
FOREMAN_AGENT_TIMEOUT_MS=300000
FOREMAN_MAX_RETRIES=2
FOREMAN_MERGE_LOCK_TIMEOUT_MS=120000

# ── Cost guard ──
# Hard spend cap in USD. Reaching it engages the kill switch automatically.
FOREMAN_SPEND_CAP_USD=25
FOREMAN_COST_PER_AGENT_RUN_USD=0.15
